{
  "name": "weeklygrant",
  "version": "1.0.0",
  "description": "Estimate the API-equivalent value of a weekly Codex grant from local session logs.",
  "bin": {
    "weeklygrant": "./dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build --silent && node dist/bin/cli.js",
    "dev": "tsx src/bin/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm test && npm run check && npm run build"
  },
  "files": [
    "dist",
    "PRIVACY.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "codex",
    "cli",
    "usage",
    "tui"
  ],
  "author": "aneeshpatne",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aneeshpatne/weeklygrant.git"
  },
  "bugs": {
    "url": "https://github.com/aneeshpatne/weeklygrant/issues"
  },
  "homepage": "https://github.com/aneeshpatne/weeklygrant#readme",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
